# VZT Video-Intel — environment variables
# Copy to .env (docker/.env) and adjust as needed.

# Backend URLs (clients read these; defaults match the docker-compose ports)
WHISPERX_URL=http://localhost:9010
QWEN_VL_URL=http://localhost:9011
SAM2_URL=http://localhost:9012
SCENEDETECT_URL=http://localhost:9013
EASYOCR_URL=http://localhost:9014
CLIP_URL=http://localhost:9015

# Optional: Mux base URL for timestamp citation
MUX_BASE_URL=

# WhisperX model size — large-v3, medium, small, tiny
WHISPER_MODEL=large-v3

# HuggingFace token (required for Qwen-VL and Pyannote diarization on first download)
HF_TOKEN=

# Qwen2.5-VL variant — 7B for single GPU (24GB), 72B for multi-GPU
QWEN_MODEL=Qwen/Qwen2.5-VL-7B-Instruct

# EasyOCR languages (comma-separated)
OCR_LANGS=en

# CLIP model — ViT-L-14 (default) or ViT-bigG-14 for better quality at 3x cost
CLIP_MODEL=ViT-L-14
